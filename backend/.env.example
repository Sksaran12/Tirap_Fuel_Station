# Local development. Copy to `.env` and change the passwords.
#
# PostgreSQL is the only supported database. Two ways to point at one:
#
# 1. Local PostgreSQL (easiest):
#      cd backend
#      npm run db:setup
#    The script asks for the PostgreSQL superuser password, creates the `tirap`
#    role + database with a generated password, and rewrites DATABASE_URL below.
#
# 2. Supabase (same database used in production):
#    Dashboard → Connect → "Session pooler" and copy the URI. It must look like
#      postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?schema=public&sslmode=require
#    Use the pooler host, NOT db.<PROJECT-REF>.supabase.co — the direct host is
#    IPv6-only and Render cannot reach it.
#
# Format:
#   postgresql://ROLE:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
# Use 127.0.0.1 if `localhost` resolves to IPv6 on your machine.
DATABASE_URL="postgresql://tirap:CHANGE_ME_RUN_DB_SETUP@localhost:5432/tirap?schema=public"
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE=tirap_session
OWNER_USERNAME=owner
OWNER_PASSWORD=tirap12345

# Cloudflare R2 file storage (optional — file uploads are disabled when these are absent)
# 1. Create a bucket at dash.cloudflare.com → R2 Object Storage
# 2. Create an API token with Object Read & Write on your bucket
# 3. Fill in the four values below
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tirap-docs

# Do NOT add VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY here.
# Vite only reads .env files at the repo root, and this app never talks to
# Supabase from the browser: Prisma on the server is the only database client.
# A publishable key is not a Postgres password and cannot replace DATABASE_URL.
