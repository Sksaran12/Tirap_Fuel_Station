# Local development defaults. Copy to `.env` and change the password.
# SQLite is the default because it needs no server. For PostgreSQL:
#   1. set provider = "postgresql" in prisma/schema.prisma
#   2. DATABASE_URL="postgresql://user:password@localhost:5432/tirap?schema=public"
#   3. npx prisma db push && node src/seed.js
DATABASE_URL="file:./dev.db"
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE=tirap_session
OWNER_USERNAME=owner
OWNER_PASSWORD=tirap12345
