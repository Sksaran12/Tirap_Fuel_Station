# Copy to infra/r2/.env (ignored by git) only if you prefer a file over shell env.
# The Cloudflare API token needs: Account > Workers R2 Storage > Edit.
CLOUDFLARE_API_TOKEN=
# CF_ACCOUNT_ID is the same variable name the backend uses (backend/src/r2.js).
CF_ACCOUNT_ID=
R2_BUCKET=tirap-docs
APP_ORIGIN=https://app.yourdomain.com
# Extra origins are passed on the command line with --extra-origin.
